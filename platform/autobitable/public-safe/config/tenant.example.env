# Copy this file to .secrets/adapter.env and replace every placeholder locally.
AUTOBITABLE_HOST=127.0.0.1
AUTOBITABLE_PORT=3510
# Keep tenant state outside the source checkout. Both paths must be absolute.
AUTOBITABLE_REGISTRY_PATH=/absolute/path/to/private-autobitable/registry/bitable-webhooks.json
AUTOBITABLE_RUN_STORE_PATH=/absolute/path/to/private-autobitable/data/webhook-runs.jsonl
AUTOBITABLE_WEBHOOK_SECRETS_BY_ID='{}'
SM_API_BASE=http://127.0.0.1:3501
