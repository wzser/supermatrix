# Copy these values into the invoking shell; do not source secrets from here.
# FP_ROOT must be the absolute path of this bundle after checkout.
export FP_ROOT="/path/to/public-onboarding-v2"
export FP_PYTHON="/path/to/python3.11"
# State must be outside the static bundle; in-bundle paths are rejected.
export FP_STATE_DIR="/path/to/agent-state"

# The one-shot session-meta path requires a user-owned config file. Do not put
# tokens or credentials in this public bundle; empty values are intentionally
# rejected.
# export SESSION_META_CONFIG="/abs/user-owned/session-meta.runtime.json"
# The JSON config must provide asset_id, base_token, table_id, from_session,
# queue_entrypoint, queue_db, registry_glob, lark_cli, lark_identity, and
# receipt_path. queue_db and registry_glob must point to user-owned paths.
