# Public, non-secret example. Copy this file and replace only the local paths and
# values approved for the receiving installation. Do not source this file as-is.

# SuperMatrix runtime inputs (read-only from Heartbeat's point of view).
SM_API_BASE=http://127.0.0.1:3501
SM_RUNTIME_ROOT=/path/to/supermatrix-runtime
SM_DB_PATH=/path/to/supermatrix-runtime/data/supermatrix.db

# Heartbeat-owned writable state. Keep it outside the source checkout and distinct
# from SM_DB_PATH. The parent directory may be created by the first real run.
HEARTBEAT_STATE_DB=/path/to/heartbeat-state/heartbeat.sqlite

# Existing command-line capability; no new installer is required.
SM_LARK_CLI_PATH=lark-cli

# The default uses the existing SuperMatrix agent backend through spawn2.0.
# Replace the model with one marked available by the receiving installation.
HEARTBEAT_CONTROLLER_PROVIDER=spawn
HEARTBEAT_CONTROLLER_MODEL=gpt-5.4-mini
HEARTBEAT_ESCALATION_MODEL=gpt-5.5
HEARTBEAT_SESSION=heartbeat

# Optional unresolved-issue handoff. Empty means escalation to a shared todo
# owner is unavailable and Heartbeat must fail closed; it must not guess a target.
HEARTBEAT_TODOMASTER_SESSION=

# Optional full-table dedupe read. All four values are required together; no
# default remote resource identifiers are shipped.
HEARTBEAT_TODO_DEDUPE_BASE_TOKEN=
HEARTBEAT_TODO_DEDUPE_TABLE_ID=
HEARTBEAT_TODO_DEDUPE_CONTENT_FIELD_ID=
HEARTBEAT_TODO_DEDUPE_SOURCE_FIELD_ID=
HEARTBEAT_TODO_DEDUPE_AS=bot

# The three runtime mirrors are disabled by default. Leave identifiers empty
# unless the receiving owner has separately enabled and authorized the asset.
HEARTBEAT_TRIGGER_FEISHU_TABLE_ID=
HEARTBEAT_TODO_FEISHU_TABLE_ID=
HEARTBEAT_TODO_AGG_FEISHU_TABLE_ID=
HEARTBEAT_LOG_FEISHU_BASE_TOKEN=
