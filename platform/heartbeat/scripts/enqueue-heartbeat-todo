#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from heartbeat_patrol.config import load_config
from heartbeat_patrol.sm_reader import SuperMatrixReader
from heartbeat_patrol.state import HeartbeatState


WORKSPACE = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description="Enqueue an idempotent heartbeat todo for a session.")
    parser.add_argument("--session", required=True)
    parser.add_argument("--key", required=True)
    parser.add_argument("--message", required=True)
    parser.add_argument("--source", default="heartbeat-cli")
    parser.add_argument("--source-session", default="")
    parser.add_argument("--source-ref", default="")
    parser.add_argument("--todo-type", default="general")
    parser.add_argument("--batch-key", default="")
    parser.add_argument("--batch-mode", choices=["auto", "single"], default="auto")
    parser.add_argument("--expected-count", type=int)
    parser.add_argument("--settle-after-seconds", type=int, default=600)
    parser.add_argument("--max-wait-seconds", type=int, default=1800)
    args = parser.parse_args()

    try:
        cfg = load_config()
        session = SuperMatrixReader(cfg.sm_db_path).get_session_by_name(args.session)
        if session is None:
            print(json.dumps({"ok": False, "error": f"session not found: {args.session}"}, ensure_ascii=False))
            return 2
        state = HeartbeatState(cfg.state_db_path)
        # heartbeat 自己 child 的晚到结果：直接收口 child_spawns，不进 todo 池也不拒绝
        # （拒绝会让框架的 spawn-closure-watcher 无限复读投递）。
        if session["name"] == cfg.heartbeat_session and args.todo_type == "spawn_closure":
            result = state.record_self_spawn_closure(
                heartbeat_session=session["name"],
                logical_key=args.key,
                message=args.message,
                source=args.source,
                source_session=args.source_session,
            )
            print(json.dumps({"ok": True, **result}, ensure_ascii=False, sort_keys=True))
            return 0
        result = state.enqueue_todo(
            target_session=session["name"],
            logical_key=args.key,
            message=args.message,
            source=args.source,
            source_session=args.source_session,
            source_ref=args.source_ref,
            todo_type=args.todo_type,
            target_heartbeat_enabled=session.get("heartbeat_enabled") == 1,
            batch_key=args.batch_key,
            batch_mode=args.batch_mode,
            expected_count=args.expected_count,
            settle_after_seconds=args.settle_after_seconds,
            max_wait_seconds=args.max_wait_seconds,
        )
        if result.get("status") == "inserted":
            result["patrol_trigger"] = trigger_target_patrol(
                state=state,
                target_session=session["name"],
                logical_key=args.key,
                todo_id=str(result.get("todo_id") or ""),
            )
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))
        return 1

    if result.get("status") == "target_not_heartbeat_enabled":
        print(json.dumps({"ok": False, **result}, ensure_ascii=False))
        return 3

    print(json.dumps({"ok": True, **result}, ensure_ascii=False, sort_keys=True))
    return 0


def trigger_target_patrol(
    *,
    state: HeartbeatState,
    target_session: str,
    logical_key: str,
    todo_id: str,
) -> dict[str, object]:
    if os.environ.get("HEARTBEAT_ENQUEUE_TRIGGER", "1") == "0":
        return {"status": "disabled"}
    pause = state.active_pause_for_session(target_session)
    if pause is not None:
        status = str(pause.get("status") or "paused")
        expires_at = str(pause.get("expires_at") or "")
        state.log_event(
            event_type="todo_patrol_trigger_skipped_paused",
            target_session=target_session,
            logical_key=logical_key,
            status="skipped",
            summary=(
                f"todo_id={todo_id}; pause_status={status}; "
                f"expires_at={expires_at or 'never'}; reason={pause.get('reason') or ''}"
            ),
            trigger_source="todo_pool",
            trigger_cause="heartbeat_paused",
            trigger_location=target_session,
        )
        return {
            "status": "skipped",
            "reason": "heartbeat_paused",
            "pause_status": status,
            "expires_at": expires_at,
        }
    log_dir = Path(os.environ.get("HEARTBEAT_ENQUEUE_TRIGGER_LOG_DIR", str(WORKSPACE / "data" / "enqueue-triggers")))
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / f"{target_session}.log"
    env = os.environ.copy()
    # watch 模式：起有界 busy->idle watcher，在目标 session 空闲后尽快注入；
    # 关闭时退回旧的一次性定向巡检。
    watch_mode = os.environ.get("HEARTBEAT_TODO_WATCH_ENABLED", "1") != "0"
    script = "heartbeat-todo-watch" if watch_mode else "heartbeat-patrol"
    command = [sys.executable, str(WORKSPACE / "scripts" / script), "--session", target_session]
    try:
        output = log_path.open("ab")
        try:
            process = subprocess.Popen(
                command,
                cwd=str(WORKSPACE),
                env=env,
                stdout=output,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        finally:
            output.close()
    except Exception as exc:
        state.log_event(
            event_type="todo_patrol_trigger_failed",
            target_session=target_session,
            logical_key=logical_key,
            status="failed",
            summary=f"todo_id={todo_id}; error={exc}",
            trigger_source="todo_pool",
            trigger_cause="enqueue_trigger",
            trigger_location=target_session,
        )
        return {"status": "failed", "error": str(exc), "log_path": str(log_path)}
    try:
        state.log_event(
            event_type="todo_patrol_trigger_started",
            target_session=target_session,
            logical_key=logical_key,
            status="started",
            summary=f"todo_id={todo_id}; pid={process.pid}; mode={'watch' if watch_mode else 'patrol'}; log_path={log_path}",
            trigger_source="todo_pool",
            trigger_cause="enqueue_trigger",
            trigger_location=target_session,
        )
    except sqlite3.OperationalError as exc:
        if "locked" not in str(exc).lower():
            raise
        audit_error = str(exc)
        try:
            with log_path.open("ab") as output:
                output.write(
                    (
                        f"todo_patrol_trigger_started audit deferred: todo_id={todo_id}; "
                        f"pid={process.pid}; error={audit_error}\n"
                    ).encode("utf-8", errors="replace")
                )
        except OSError:
            pass
        return {
            "status": "started_audit_deferred",
            "mode": "watch" if watch_mode else "patrol",
            "pid": process.pid,
            "log_path": str(log_path),
            "audit_error": audit_error,
        }
    return {
        "status": "started",
        "mode": "watch" if watch_mode else "patrol",
        "pid": process.pid,
        "log_path": str(log_path),
    }


if __name__ == "__main__":
    raise SystemExit(main())
