#!/usr/bin/env python3
"""Bound heartbeat enqueue-trigger logs without disrupting localwatch writers."""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from heartbeat_patrol.history import maintain_enqueue_trigger_logs


WORKSPACE = Path(__file__).resolve().parents[1]


def main() -> int:
    default_log_dir = Path(
        os.environ.get("HEARTBEAT_ENQUEUE_TRIGGER_LOG_DIR", str(WORKSPACE / "data" / "enqueue-triggers"))
    )
    parser = argparse.ArgumentParser(
        description="Rotate heartbeat enqueue-trigger logs in place and compact closed segments."
    )
    parser.add_argument("--log-dir", type=Path, default=default_log_dir)
    parser.add_argument("--session", action="append", default=[], help="Limit active rotation to this session.")
    parser.add_argument(
        "--max-bytes",
        type=int,
        default=int(os.environ.get("HEARTBEAT_ENQUEUE_LOG_MAX_BYTES", str(8 * 1024 * 1024))),
    )
    parser.add_argument(
        "--compact-after-seconds",
        type=int,
        default=int(os.environ.get("HEARTBEAT_ENQUEUE_LOG_COMPACT_AFTER_SECONDS", "3600")),
    )
    parser.add_argument(
        "--retention-days",
        type=int,
        default=int(os.environ.get("HEARTBEAT_ENQUEUE_LOG_RETENTION_DAYS", "14")),
    )
    parser.add_argument(
        "--max-segments",
        type=int,
        default=int(os.environ.get("HEARTBEAT_ENQUEUE_LOG_MAX_SEGMENTS", "8")),
    )
    parser.add_argument(
        "--minimum-keep",
        type=int,
        default=int(os.environ.get("HEARTBEAT_ENQUEUE_LOG_MINIMUM_KEEP", "2")),
    )
    args = parser.parse_args()

    try:
        result = maintain_enqueue_trigger_logs(
            log_dir=args.log_dir,
            max_bytes=args.max_bytes,
            sessions=args.session or None,
            compact_after_seconds=args.compact_after_seconds,
            retention_days=args.retention_days,
            max_segments_per_session=args.max_segments,
            minimum_keep=args.minimum_keep,
        )
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False, sort_keys=True))
        return 1
    print(json.dumps({"ok": True, **result}, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
