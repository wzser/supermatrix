#!/usr/bin/env python3
"""Watch one session's todo pool and inject as soon as it turns idle (debounced)."""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from heartbeat_patrol.config import load_config
from heartbeat_patrol.sm_reader import SuperMatrixReader
from heartbeat_patrol.state import HeartbeatState
from heartbeat_patrol.todo_watch import run_todo_watch, watch_settings_from_config

WORKSPACE = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description="Watch a session and drain its heartbeat todos on idle.")
    parser.add_argument("--session", required=True)
    args = parser.parse_args()

    cfg = load_config()
    # A watcher is only launched for an existing todo DB. Avoid running migrations in every
    # detached worker, which otherwise makes LocalWatch restarts contend on the schema lock.
    state = HeartbeatState.open_existing(cfg.state_db_path)
    reader = SuperMatrixReader(cfg.sm_db_path)

    def fire_patrol() -> None:
        subprocess.run(
            [sys.executable, str(WORKSPACE / "scripts" / "heartbeat-patrol"), "--session", args.session],
            cwd=str(WORKSPACE),
            check=False,
        )

    result = run_todo_watch(
        state=state,
        reader=reader,
        target_session=args.session,
        fire_patrol=fire_patrol,
        settings=watch_settings_from_config(cfg),
    )
    print(json.dumps({"session": args.session, **result}, ensure_ascii=False, sort_keys=True))
    return 1 if result.get("status") == "error" else 0


if __name__ == "__main__":
    raise SystemExit(main())
