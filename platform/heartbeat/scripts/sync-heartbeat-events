#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from heartbeat_patrol.config import load_config
from heartbeat_patrol.event_sync import (
    sync_events_to_feishu,
    sync_todo_aggregates_to_feishu,
    sync_todos_to_feishu,
)
from heartbeat_patrol.state import HeartbeatState


def main() -> int:
    base_token = os.environ.get("HEARTBEAT_LOG_FEISHU_BASE_TOKEN", "").strip()
    event_table_id = (
        os.environ.get("HEARTBEAT_TRIGGER_FEISHU_TABLE_ID", "").strip()
        or os.environ.get("HEARTBEAT_LOG_FEISHU_TABLE_ID", "").strip()
    )
    todo_table_id = os.environ.get("HEARTBEAT_TODO_FEISHU_TABLE_ID", "").strip()
    todo_aggregate_table_id = os.environ.get("HEARTBEAT_TODO_AGG_FEISHU_TABLE_ID", "").strip()

    cfg = load_config()
    state = HeartbeatState(cfg.state_db_path)
    identity = os.environ.get("HEARTBEAT_LOG_FEISHU_AS", "bot")
    limit = int(os.environ.get("HEARTBEAT_LOG_SYNC_LIMIT", "500"))
    result = {
        "events": sync_events_to_feishu(
            state=state,
            base_token=base_token,
            table_id=event_table_id,
            lark_cli=cfg.lark_cli,
            identity=identity,
            limit=limit,
        )
    }
    result["todos"] = sync_todos_to_feishu(
        state=state,
        base_token=base_token,
        table_id=todo_table_id,
        lark_cli=cfg.lark_cli,
        identity=identity,
        limit=limit,
    )
    result["todo_aggregates"] = sync_todo_aggregates_to_feishu(
        state=state,
        base_token=base_token,
        table_id=todo_aggregate_table_id,
        lark_cli=cfg.lark_cli,
        identity=identity,
        limit=limit,
    )
    print(json.dumps({"ok": True, **result}, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
