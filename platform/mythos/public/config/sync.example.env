# User-owned Feishu targets. Every value below must be replaced before live use.
# Empty values are intentional: sync-kb.sh fails closed when a live target is
# missing. This file is safe to publish because it contains no credential.

MYTHOS_CHARTER_URL=""
MYTHOS_MAP_URL=""
MYTHOS_WIKI_URL_PREFIX=""
MYTHOS_PARENT_NODE_TOKEN=""
MYTHOS_SPACE_ID=""
MYTHOS_SOURCES_ASSET=""
MYTHOS_QUERIES_ASSET=""
MYTHOS_ENQUEUE_BIN=""
MYTHOS_ENQUEUE_STATUS_BIN="feishu-sync-status"
MYTHOS_LARK_CLI="lark-cli"

# Optional public seed root override; the recipient may point this at another
# compatible KB root without changing the command or source files.
MYTHOS_KB_ROOT=""
