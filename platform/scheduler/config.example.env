# Copy to an untracked local environment file and replace placeholders.
# Never commit credentials, databases, logs, or runtime receipts.

# Core runtime inputs.
SM_RUNTIME_ROOT=${HOME}/SuperMatrixRuntime
SM_DB=${SM_RUNTIME_ROOT}/data/supermatrix.db
SM_BASE_URL=http://127.0.0.1:3501

# Scheduler v2: one instance, loopback by default, independent writable DB.
SCHEDULER_V2_HOST=127.0.0.1
SCHEDULER_V2_PORT=3502
SCHEDULER_V2_DB=${SM_RUNTIME_ROOT}/data/scheduler-v2.db
SCHEDULER_ADMIN_TOKEN=GENERATE_A_NEW_LOCAL_RANDOM_TOKEN

# Optional daily table mirror dependency. Leave the default when the command
# is installed on PATH; otherwise set a local path supplied by your runtime.
SCHEDULER_MIRROR_ENQUEUE_BIN=feishu-sync-enqueue

# Optional launcher input. If set, start.sh sources this untracked file.
# SM_ENV_FILE=${PWD}/.env.local

# Cron uses the process timezone. Set this explicitly for a fixed schedule.
TZ=Asia/Shanghai
