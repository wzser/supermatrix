{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-communication-review/judgment.schema.json",
  "title": "Interview-backed judgment",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "judgment_id", "kind", "theme", "user_visible_symptom", "function_loss", "evidence", "interview_a", "interview_b", "confidence", "gray_zone_hit", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^judg-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+$"},
    "judgment_id": {"type": "string", "pattern": "^judg-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+$"},
    "kind": {"const": "primary"},
    "theme": {"enum": ["communication_gap", "wrong_owner", "false_success", "duplicate_work", "other"]},
    "user_visible_symptom": {"type": "string", "minLength": 1},
    "function_loss": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "required": ["source", "source_comm_id", "interview_a", "interview_b"],
      "properties": {
        "source": {"const": "cross_session_log"},
        "source_comm_id": {"type": "string", "minLength": 1},
        "interview_a": {"type": "string", "minLength": 1},
        "interview_b": {"type": "string", "minLength": 1}
      }
    },
    "interview_a": {"type": "string", "minLength": 1},
    "interview_b": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["high", "medium", "low"]},
    "gray_zone_hit": {"type": "string", "minLength": 1},
    "applied_to_rule": {"type": ["string", "null"]},
    "status": {"enum": ["pending", "pending_interview", "awaiting_verdict", "confirmed", "fixed", "closed"]}
  }
}
