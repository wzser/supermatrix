# Copy these values into the environment of one isolated instance.
# The local SQLite path is the queue namespace for that instance.
WATCHDOG_DB_PATH=./data/watchdog.db
SM_API_BASE=http://127.0.0.1:3501
SM_SESSION_NAME=watchdog

# Keep external side effects off for local setup and tests.
WATCHDOG_NOTIFY_DISABLED=1
WATCHDOG_DISABLE_SYNC=1

# To enable the optional Bitable mirror, provide both values from the new
# user's own Base and table. There are intentionally no public defaults.
# WATCHDOG_BITABLE_BASE_TOKEN=
# WATCHDOG_BITABLE_TABLE_ID=
