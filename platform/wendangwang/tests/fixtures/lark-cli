#!/usr/bin/env python3
"""Tiny local-only lark-cli double for the public queue acceptance test."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


FIELDS = ["键", "值"]


def _state_path() -> Path:
    value = os.environ.get("PUBLIC_LARK_STUB_STATE", "")
    if not value:
        print("PUBLIC_LARK_STUB_STATE is required", file=sys.stderr)
        raise SystemExit(2)
    return Path(value)


def _load() -> dict:
    path = _state_path()
    if not path.exists():
        return {"next_id": 1, "records": {}}
    return json.loads(path.read_text(encoding="utf-8"))


def _save(state: dict) -> None:
    path = _state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, ensure_ascii=False, sort_keys=True), encoding="utf-8")


def _arg(args: list[str], name: str, default: str = "") -> str:
    try:
        return args[args.index(name) + 1]
    except (ValueError, IndexError):
        return default


def _response(state: dict, record_ids: list[str]) -> dict:
    return {
        "ok": True,
        "data": {
            "fields": FIELDS,
            "field_type_list": ["text", "text"],
            "record_id_list": record_ids,
            "data": [[state["records"][rid].get(field, "") for field in FIELDS] for rid in record_ids],
        },
    }


def main() -> int:
    args = [arg for arg in sys.argv[1:] if arg != "--format"]
    if os.environ.get("PUBLIC_LARK_STUB_MODE") == "deny":
        payload = {"ok": False, "error": {"code": 91403, "message": "permission denied"}}
        print(json.dumps(payload))
        return 1
    if len(args) < 2 or args[0] != "base":
        print(json.dumps({"ok": False, "error": {"code": 400, "message": "unsupported stub command"}}))
        return 1

    command = args[1]
    state = _load()
    if command in {"+record-list", "+record-get"}:
        if command == "+record-get" and _arg(args, "--record-id"):
            record_ids = [_arg(args, "--record-id")]
        elif command == "+record-get" and _arg(args, "--json"):
            requested = json.loads(_arg(args, "--json")).get("record_id_list", [])
            record_ids = [str(rid) for rid in requested]
        else:
            record_ids = list(state["records"])
            filter_json = _arg(args, "--filter-json")
            if filter_json:
                filter_data = json.loads(filter_json)
                conditions = filter_data.get("conditions", [])
                record_ids = [
                    rid for rid in record_ids
                    if any(
                        len(condition) == 3
                        and state["records"][rid].get(condition[0]) == condition[2]
                        for condition in conditions
                    )
                ]
        record_ids = [rid for rid in record_ids if rid in state["records"]]
        print(json.dumps(_response(state, record_ids), ensure_ascii=False))
        return 0

    if command == "+record-upsert":
        fields = json.loads(_arg(args, "--json"))
        record_id = _arg(args, "--record-id")
        if not record_id:
            record_id = f"rec_demo_{state['next_id']}"
            state["next_id"] += 1
            state["records"][record_id] = {}
        state["records"].setdefault(record_id, {}).update(fields)
        _save(state)
        print(json.dumps({
            "ok": True,
            "updated": True,
            "ignored_fields": [],
            "data": {"record_id": record_id},
        }))
        return 0

    if command == "+field-list":
        print(json.dumps({"ok": True, "data": {"fields": [
            {"id": field, "name": field, "type": "text"} for field in FIELDS
        ]}} , ensure_ascii=False))
        return 0

    print(json.dumps({"ok": False, "error": {"code": 400, "message": f"unsupported stub command: {command}"}}))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
