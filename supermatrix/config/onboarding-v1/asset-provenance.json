{
  "version": 1,
  "publicInput": {
    "hashSchema": "sources.<kind>.files maps each repository-relative public path to {bytes,sha256}; both values describe the approved sanitized/public bytes consumed by onboarding",
    "sourceProvenance": "owner source commits and pre-sanitization source hashes remain in gitmaster's private release receipt and are never substituted for the public file hashes",
    "updateBoundary": "owners select and publish the public paths and source commit; the release publisher may refresh only the existing bytes/sha256 values after sanitization, without asking installers to edit bytes or hashes",
    "allowedReleaseMetadata": [
      "sources.<kind>.commit",
      "sources.<kind>.files.<path>.bytes",
      "sources.<kind>.files.<path>.sha256",
      "modules[].commit",
      "modules[].reviewStatus",
      "modules[].archiveSha256",
      "modules[].files.<path>.bytes",
      "modules[].files.<path>.sha256"
    ],
    "acceptance": "gitmaster retains the original source hash privately, refreshes the existing public bytes/sha256 fields from approved sanitized bytes, and freezes its archive digest from those same approved bytes; onboarding validates exact bytes and introduces no runtime-derived replacement hash",
    "finalArchiveDigest": "gitmaster freezes the archive digest from approved sanitized bytes in its private release receipt"
  },
