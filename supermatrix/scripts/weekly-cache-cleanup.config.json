    "/private/var/folders/n4/vc_51r_17qvf1k9l8x4f17tw0000gn/X"
  ],
  "rules": [
    {
      "id": "codex-unmanaged-state-backups",
      "owner": "cachem",
      "enabled": true,
      "action": "delete_children_older_than",
      "paths": ["/Users/LOCAL_USER/.codex"],
      "retentionDays": 3,
      "includeBasenamePrefixes": ["state_5.sqlite.bak-"],
      "description": "Fail-safe cleanup for unmanaged legacy Codex state copies. New recovery snapshots must use scripts/codex-state-snapshot.ts, which requires owner/reason/expiry receipts and a maximum 72-hour lifetime. The active state_5.sqlite and its WAL/SHM files do not match this prefix."
    },
    {
      "id": "uv-temp-cache",
      "owner": "cachem",
      "enabled": true,
      "action": "delete_children_older_than",
      "paths": ["/Users/LOCAL_USER/.cache/uv"],
      "retentionDays": 1,
      "includeBasenamePrefixes": [".tmp"],
      "description": "Remove abandoned uv temporary cache entries only."
    },
    {
      "id": "uv-archive-cache-old-entries",
      "owner": "cachem",
      "enabled": true,
      "action": "delete_children_older_than",
      "paths": ["/Users/LOCAL_USER/.cache/uv/archive-v0"],
      "retentionDays": 7,
      "description": "Remove old uv package archive cache entries; uv can repopulate them on demand."
    },
    {
      "id": "sm-runtime-db-backups",
      "owner": "cachem",
      "enabled": true,
      "action": "delete_children_older_than",
      "paths": [
        "/Users/LOCAL_USER/SuperMatrixRuntime/data",
        "/Users/LOCAL_USER/SuperMatrixRuntime/data/supermatrix-recovery-backups"
      ],
      "retentionDays": 3,
      "includeBasenamePrefixes": [
        "supermatrix.db.bak",
        "supermatrix.db.backup",
        "supermatrix.db.pre-",
        "supermatrix-before-",
        "scheduler.db.bak",
        "scheduler-before-",
        "scheduler-v2.db.bak"
      ],
      "description": "Fail-safe cleanup for unmanaged legacy runtime-DB snapshots after 3 days. New SuperMatrix/scheduler pre-mutation snapshots must use scripts/managed-sqlite-snapshot.ts with owner, operationId, reason and a hard 1-72 hour expiry; verified completion releases the artifact immediately. This rule is deliberately independent of disaster-backup ledgers, never creates a replacement backup, and its prefixes cannot match live supermatrix.db / scheduler.db / scheduler-v2.db or their WAL/SHM files."
    },
    {
      "id": "code-sign-clone-stale",
      "owner": "cachem",
      "enabled": true,
      "action": "delete_children_older_than",
      "paths": [
        "/private/var/folders/n4/vc_51r_17qvf1k9l8x4f17tw0000gn/X/org.ZiXun.ziniaobrowser.code_sign_clone",
        "/private/var/folders/n4/vc_51r_17qvf1k9l8x4f17tw0000gn/X/com.google.Chrome.code_sign_clone"
      ],
      "retentionDays": 7,
      "includeBasenamePrefixes": ["code_sign_clone."],
      "description": "Remove stale macOS code_sign_clone app-update leftovers (ziniao leaks ~4x343MB per day). Running apps only reference their newest clones; 7-day retention keeps those safe."
    },
    {
      "id": "codex-session-transcripts-old-days",
      "owner": "cachem",
      "enabled": false,
      "safetyState": "blocked",
      "action": "delete_children_older_than",
      "paths": [
        "/Users/LOCAL_USER/.codex/sessions/2026/01",
        "/Users/LOCAL_USER/.codex/sessions/2026/02",
        "/Users/LOCAL_USER/.codex/sessions/2026/03",
        "/Users/LOCAL_USER/.codex/sessions/2026/04",
        "/Users/LOCAL_USER/.codex/sessions/2026/05",
        "/Users/LOCAL_USER/.codex/sessions/2026/06",
        "/Users/LOCAL_USER/.codex/sessions/2026/07",
        "/Users/LOCAL_USER/.codex/sessions/2026/08",
        "/Users/LOCAL_USER/.codex/sessions/2026/09",
        "/Users/LOCAL_USER/.codex/sessions/2026/10",
        "/Users/LOCAL_USER/.codex/sessions/2026/11",
        "/Users/LOCAL_USER/.codex/sessions/2026/12"
