{
  "version": 1,
  "maxDeleteBytes": 85899345920,
  "safeRoots": [
    "/Users/LOCAL_USER/.cache",
    "/Users/LOCAL_USER/.codex",
    "/Users/LOCAL_USER/.codex/sessions",
    "/Users/LOCAL_USER/.npm",
    "/Users/LOCAL_USER/Library/Caches",
