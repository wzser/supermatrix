      "retentionDays": 45,
      "description": "SAFETY BLOCKED after the directory-mtime selector deleted recently active transcripts. Do not re-enable or remove safetyState until a reviewed per-thread activity selector, transcript backup, recovery read-back, and regression coverage replace this rule."
    },
    {
      "id": "chrome-cache-old-profiles",
      "owner": "cachem",
      "enabled": true,
